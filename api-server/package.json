{
  "name": "@deafauth/api-server",
  "version": "0.1.0",
  "description": "DeafAUTH Standalone API Server - Works alongside any auth system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run"
  },
  "keywords": [
    "deafauth",
    "accessibility",
    "paseto",
    "authentication",
    "multi-tenant"
  ],
  "dependencies": {
    "express": "^4.18.2",
    "cookie-parser": "^1.4.6",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "pg": "^8.11.0",
    "knex": "^2.5.1",
    "uuid": "^9.0.0",
    "paseto": "^3.1.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0",
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.3",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.10",
    "@types/uuid": "^9.0.8",
    "@types/pg": "^8.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
