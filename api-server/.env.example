# DeafAUTH API Server Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://deafuser:changeme@localhost:5432/deafauth
# Or specify individual components:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=deafauth
# DB_USER=deafuser
# DB_PASSWORD=changeme

# PASETO Configuration
# Generate keys with: openssl genpkey -algorithm Ed25519 -out paseto_private.pem
# Extract public key: openssl pkey -in paseto_private.pem -pubout -out paseto_public.pem
PASETO_PRIVATE_KEY=
PASETO_PUBLIC_KEY=
PASETO_KEY_ID=key-1
PASETO_ISSUER=deafauth.io
PASETO_KEYS_DIR=./keys

# Token Lifetimes (in seconds)
ACCESS_TOKEN_TTL=600        # 10 minutes
REFRESH_TOKEN_TTL=2592000   # 30 days

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: External Service Endpoints
PINKSYNC_ENDPOINT=
PINKFLOW_ENDPOINT=

# Security (production only)
SECURE_COOKIES=false  # Set to true in production with HTTPS
